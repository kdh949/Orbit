{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "agent:context": "node tools/agent/context.mjs",
    "agent:benchmark": "node tools/agent/benchmark.mjs",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "compose:down": "docker compose down --remove-orphans",
    "compose:up": "docker compose up --build",
    "css:ownership": "node tools/agent/css-ownership.mjs",
    "dev:local": "bash infra/scripts/dev-up.sh",
    "db:migration:revert": "pnpm --filter @orbit/api migration:revert",
    "db:migration:run": "pnpm --filter @orbit/api migration:run",
    "cleanup:kdh-home-projects": "pnpm --filter @orbit/api cleanup:kdh-home-projects",
    "demo:coaching:reset": "pnpm --filter @orbit/api demo:coaching:reset",
    "env:sync:stg": "node infra/scripts/sync-personal-staging-doppler.mjs",
    "env:sync:stg:apply": "node infra/scripts/sync-personal-staging-doppler.mjs --apply",
    "test:coaching:migrations": "bash infra/scripts/test-adaptive-coaching-migrations.sh",
    "test:coaching:integration": "bash infra/scripts/test-adaptive-coaching-integration.sh",
    "test:coaching:e2e": "pnpm --filter @orbit/shared build && pnpm --filter @orbit/editor-core build && pnpm test:smoke --grep \"adaptive coaching\"",
    "test:coaching:python": "cd services/python-worker && uv sync --locked && uv run ruff check . && uv run mypy app && uv run pytest",
    "test:css-ownership": "node --test tools/agent/css-ownership.test.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "node tools/agent/format-check.mjs",
    "lint:boundaries": "node tools/agent/check-import-boundaries.mjs",
    "lint:cycles": "node tools/agent/check-source-cycles.mjs",
    "py:sync": "cd services/python-worker && uv sync",
    "py:test": "cd services/python-worker && uv run pytest",
    "repo:doctor": "node tools/agent/repo-doctor.mjs",
    "test": "turbo run test",
    "test:agent-context": "node --test tools/agent/context.test.mjs",
    "test:agent-benchmark": "node --test tools/agent/benchmark.test.mjs",
    "test:import-boundaries": "node --test tools/agent/check-import-boundaries.test.mjs",
    "test:source-cycles": "node --test tools/agent/check-source-cycles.test.mjs",
    "test:format-check": "node --test tools/agent/format-check.test.mjs",
    "test:package-task-graph": "node --test tools/agent/package-task-graph.test.mjs",
    "test:repo-doctor": "node --test tools/agent/repo-doctor.test.mjs",
    "test:verify-affected": "node --test tools/agent/verify-affected.test.mjs",
    "test:verification-env": "node --test tools/agent/verification-env.test.mjs",
    "test:verify-scope": "node --test tools/agent/verify-scope.test.mjs",
    "test:activity-slides:e2e": "node infra/scripts/run-playwright-test.mjs activity-slides.spec.ts",
    "test:env-contract": "node --test infra/scripts/personal-staging-env.test.mjs infra/scripts/personal-staging-wrapper.test.mjs infra/scripts/personal-staging-deploy.test.mjs",
    "test:nli-browser": "node infra/scripts/run-semantic-cue-nli-browser-benchmark.mjs",
    "test:smoke": "node infra/scripts/run-playwright-test.mjs",
    "typecheck": "turbo run typecheck",
    "verify:affected": "node tools/agent/verify-affected.mjs",
    "verify:scope": "node tools/agent/verify-scope.mjs"
  },
  "devDependencies": {
    "@orbit/editor-core": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "axe-core": "4.10.3",
    "pg": "^8.22.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
