prometheus.remote_write "monitoring" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}

prometheus.scrape "orbit_services" {
  scrape_interval = "15s"
  targets = [
    { "__address__" = "api:3000", "__metrics_path__" = "/internal/metrics", "job" = "orbit-api" },
    { "__address__" = "worker:3001", "__metrics_path__" = "/metrics", "job" = "orbit-worker" },
    { "__address__" = "python-worker:8000", "__metrics_path__" = "/internal/metrics", "job" = "orbit-python-worker" },
    { "__address__" = "postgres-exporter:9187", "job" = "orbit-postgres" },
    { "__address__" = "redis-exporter:9121", "job" = "orbit-redis" },
    { "__address__" = "private-evidence-redis-exporter:9121", "job" = "orbit-private-evidence-redis" },
    { "__address__" = "nginx-exporter:9113", "job" = "orbit-nginx" },
    { "__address__" = "node-exporter:9100", "job" = "orbit-node" },
    { "__address__" = "cadvisor:8080", "job" = "orbit-cadvisor" },
    { "__address__" = "127.0.0.1:12345", "job" = "orbit-alloy" },
  ]
  forward_to = [prometheus.relabel.environment.receiver]
}

prometheus.scrape "orbit_minio" {
  scrape_interval = "15s"
  metrics_path = "/minio/v2/metrics/cluster"
  targets = [{ "__address__" = "minio:9000", "job" = "orbit-minio" }]
  authorization {
    type        = "Bearer"
    credentials = sys.env("MINIO_PROMETHEUS_BEARER_TOKEN")
  }
  forward_to = [prometheus.relabel.environment.receiver]
}

prometheus.relabel "environment" {
  forward_to = [prometheus.remote_write.monitoring.receiver]
  rule {
    target_label = "environment"
    replacement  = sys.env("OBSERVABILITY_ENVIRONMENT")
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "container_logs" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = { "environment" = sys.env("OBSERVABILITY_ENVIRONMENT"), "platform" = "docker" }
  relabel_rules = discovery.relabel.container_logs.rules
  forward_to    = [loki.write.monitoring.receiver]
}

local.file_match "nginx_access" {
  path_targets = [
    {
      "__path__" = "/var/log/nginx/orbit_access.log",
      "service"  = "orbit-nginx",
      "platform" = "host",
    },
  ]
}

loki.source.file "nginx_access" {
  targets    = local.file_match.nginx_access.targets
  forward_to = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = sys.env("LOKI_WRITE_URL")
  }
}

otelcol.receiver.otlp "applications" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.memory_limiter.applications.input]
  }
}

otelcol.processor.memory_limiter "applications" {
  check_interval = "1s"
  limit          = "256MiB"
  spike_limit    = "64MiB"

  output {
    traces = [otelcol.processor.batch.applications.input]
  }
}

otelcol.processor.batch "applications" {
  timeout             = "200ms"
  send_batch_size     = 512
  send_batch_max_size = 1024

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("TEMPO_OTLP_HTTP_ENDPOINT")
  }

  retry_on_failure {
    enabled         = true
    initial_interval = "1s"
    max_interval     = "10s"
    max_elapsed_time = "60s"
  }

  sending_queue {
    enabled       = true
    queue_size    = 1024
    num_consumers = 2
  }
}
