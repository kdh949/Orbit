prometheus.remote_write "monitoring" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}

prometheus.scrape "orbit_services" {
  scrape_interval = "15s"
  targets = [
    { "__address__" = "api:3000", "__metrics_path__" = "/internal/metrics", "job" = "orbit-api" },
    { "__address__" = "worker:3001", "__metrics_path__" = "/metrics", "job" = "orbit-worker" },
    { "__address__" = "python-worker:8000", "__metrics_path__" = "/internal/metrics", "job" = "orbit-python-worker" },
    { "__address__" = "postgres-exporter:9187", "job" = "orbit-postgres" },
    { "__address__" = "redis-exporter:9121", "job" = "orbit-redis" },
    { "__address__" = "private-evidence-redis-exporter:9121", "job" = "orbit-private-evidence-redis" },
    { "__address__" = "node-exporter:9100", "job" = "orbit-node" },
    { "__address__" = "cadvisor:8080", "job" = "orbit-cadvisor" },
  ]
  forward_to = [prometheus.relabel.environment.receiver]
}

prometheus.scrape "orbit_minio" {
  scrape_interval = "15s"
  metrics_path = "/minio/v2/metrics/cluster"
  targets = [{ "__address__" = "minio:9000", "job" = "orbit-minio" }]
  authorization {
    type        = "Bearer"
    credentials = sys.env("MINIO_PROMETHEUS_BEARER_TOKEN")
  }
  forward_to = [prometheus.relabel.environment.receiver]
}

prometheus.relabel "environment" {
  forward_to = [prometheus.remote_write.monitoring.receiver]
  rule {
    target_label = "environment"
    replacement  = sys.env("OBSERVABILITY_ENVIRONMENT")
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "container_logs" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = { "environment" = sys.env("OBSERVABILITY_ENVIRONMENT"), "platform" = "docker" }
  relabel_rules = discovery.relabel.container_logs.rules
  forward_to    = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = sys.env("LOKI_WRITE_URL")
  }
}
